CREATE DATABASE nike_adidas_project;
\c nike_adidas_project;

-- =============================================================
-- STAGE 1 — Schema design
-- Separating country from city so the dashboard can aggregate
-- at country level and plot individual dots at city level.
-- factory_code is a human-readable business key;
-- factory_id is just a surrogate for the database.
-- =============================================================

CREATE TABLE factories (
    factory_id      SERIAL PRIMARY KEY,
    brand           VARCHAR(20),
    factory_code    VARCHAR(20),
    country         VARCHAR(50),
    city            VARCHAR(50),
    year            INT,
    workers         INT,
    monthly_output  INT,
    production_cost DECIMAL(10,2),
    latitude        FLOAT,
    longitude       FLOAT
);


-- =============================================================
-- STAGE 2 — First attempt: generate_series + recursive CTE
-- This looked clever but city assignments clustered wrong —
-- every Nike row for Vietnam landed in the same city regardless
-- of which factory it was supposed to represent.
-- Kept here to show the iteration.
-- =============================================================

WITH RECURSIVE numbers AS (
    SELECT generate_series(1, 200) AS n
),
countries AS (
    SELECT * FROM (VALUES
        ('Vietnam',   40, 16.0,  108.0,  'Ho Chi Minh', 10.8231,  106.6297),
        ('Vietnam',   40, 16.0,  108.0,  'Hanoi',       21.0285,  105.8542),
        ('Vietnam',   40, 16.0,  108.0,  'Da Nang',     16.0544,  108.2022),
        ('Indonesia', 25, -0.8,  113.9,  'Jakarta',     -6.2088,  106.8456),
        ('Indonesia', 25, -0.8,  113.9,  'Surabaya',    -7.2575,  112.7521),
        ('Indonesia', 25, -0.8,  113.9,  'Bandung',     -6.9175,  107.6191),
        ('China',     15, 35.9,  104.2,  'Shanghai',    31.2304,  121.4737),
        ('China',     15, 35.9,  104.2,  'Guangzhou',   23.1291,  113.2644),
        ('China',     15, 35.9,  104.2,  'Suzhou',      31.2990,  120.5853),
        ('Thailand',   8, 15.9,  101.0,  'Bangkok',     13.7367,  100.5231),
        ('Thailand',   8, 15.9,  101.0,  'Chonburi',    13.3611,  100.9847),
        ('USA',        5, 39.8,  -98.5,  'Portland',    45.5152, -122.6784),
        ('USA',        5, 39.8,  -98.5,  'Memphis',     35.1495,  -90.0490),
        ('Germany',    4, 51.2,   10.5,  'Berlin',      52.5200,   13.4050),
        ('Germany',    4, 51.2,   10.5,  'Munich',      48.1351,   11.5820)
    ) AS c(country_name, pct, lat, lng, city_name, city_lat, city_lng)
),
brands AS (
    SELECT 'Nike' AS brand_name UNION SELECT 'Adidas'
)
INSERT INTO factories (brand, factory_code, country, city, year, workers, monthly_output, production_cost, latitude, longitude)
SELECT
    b.brand_name,
    UPPER(CONCAT(LEFT(b.brand_name, 2), '-', LEFT(c.country_name, 2), '-', LPAD(n.n::TEXT, 3, '0'))),
    c.country_name,
    c.city_name,
    2023 + (n.n % 2),
    CASE
        WHEN c.country_name = 'Vietnam'   THEN 25000 + (n.n % 15000)
        WHEN c.country_name = 'Indonesia' THEN 22000 + (n.n % 14000)
        WHEN c.country_name = 'China'     THEN 18000 + (n.n % 12000)
        WHEN c.country_name = 'Thailand'  THEN 12000 + (n.n % 10000)
        WHEN c.country_name = 'USA'       THEN  3000 + (n.n %  4000)
        ELSE                                    2000 + (n.n %  5000)
    END,
    (CASE
        WHEN c.country_name = 'Vietnam'   THEN 25000 + (n.n % 15000)
        WHEN c.country_name = 'Indonesia' THEN 22000 + (n.n % 14000)
        WHEN c.country_name = 'China'     THEN 18000 + (n.n % 12000)
        WHEN c.country_name = 'Thailand'  THEN 12000 + (n.n % 10000)
        WHEN c.country_name = 'USA'       THEN  3000 + (n.n %  4000)
        ELSE                                    2000 + (n.n %  5000)
    END) * (60 + (n.n % 31)),
    ROUND(((CASE
        WHEN c.country_name = 'Vietnam'   THEN 25000 + (n.n % 15000)
        WHEN c.country_name = 'Indonesia' THEN 22000 + (n.n % 14000)
        WHEN c.country_name = 'China'     THEN 18000 + (n.n % 12000)
        WHEN c.country_name = 'Thailand'  THEN 12000 + (n.n % 10000)
        WHEN c.country_name = 'USA'       THEN  3000 + (n.n %  4000)
        ELSE                                    2000 + (n.n %  5000)
    END) * (60 + (n.n % 31)) / 100000.0) +
    CASE
        WHEN c.country_name = 'Vietnam'   THEN 15 + (n.n % 10)
        WHEN c.country_name = 'Indonesia' THEN 13 + (n.n % 10)
        WHEN c.country_name = 'China'     THEN 20 + (n.n % 12)
        WHEN c.country_name = 'Thailand'  THEN 12 + (n.n %  8)
        WHEN c.country_name = 'USA'       THEN 35 + (n.n % 15)
        ELSE                                   25 + (n.n % 15)
    END, 1),
    c.city_lat,
    c.city_lng
FROM numbers n
CROSS JOIN brands b
CROSS JOIN LATERAL (
    SELECT * FROM countries
    WHERE n.n % 100 <= pct OR pct = 40
    LIMIT 1
) c
WHERE n.n <= 200;

-- Problem: all factories per city share exact same coordinates.
-- Tableau collapses them into one dot. Moving to hardcoded VALUES.

DROP TABLE IF EXISTS factories;


