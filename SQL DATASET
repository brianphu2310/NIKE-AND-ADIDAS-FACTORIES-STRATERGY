-- =============================================================
-- STAGE 4 — Coordinate jitter so dots spread on the map
-- First tried uniform offset by factory_id — dots lined up
-- too neatly in a diagonal. Switched to random() for a more
-- natural spread within each city area.
-- setseed() makes it reproducible on every re-run.
-- =============================================================

SELECT setseed(0.42);

UPDATE factories SET
    latitude  = latitude  + (random() * 0.09 - 0.045),
    longitude = longitude + (random() * 0.09 - 0.045) / cos(radians(latitude));

-- Verify coordinates look sensible
SELECT factory_code, city,
       ROUND(latitude::numeric, 4)  AS lat,
       ROUND(longitude::numeric, 4) AS lng
FROM factories
ORDER BY city;

